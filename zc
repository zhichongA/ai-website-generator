-- ai_code_mother.app definition

CREATE TABLE `app` (
                       `id` bigint(20) NOT NULL COMMENT '主键ID',
                       `appName` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '应用名称',
                       `cover` varchar(1024) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '应用封面',
                       `initPrompt` text COLLATE utf8mb4_unicode_ci COMMENT '应用初始化的 prompt',
                       `codeGenType` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '代码生成类型（枚举）',
                       `deployKey` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '部署标识',
                       `deployedTime` datetime DEFAULT NULL COMMENT '部署时间',
                       `priority` int(11) DEFAULT NULL COMMENT '优先级',
                       `userId` bigint(20) DEFAULT NULL COMMENT '创建用户id',
                       `editTime` datetime DEFAULT NULL COMMENT '编辑时间',
                       `createTime` datetime DEFAULT NULL COMMENT '创建时间',
                       `updateTime` datetime DEFAULT NULL COMMENT '更新时间',
                       `isDelete` tinyint(4) DEFAULT '0' COMMENT '是否删除（0-未删除，1-已删除）',
                       PRIMARY KEY (`id`),
                       KEY `idx_user_id` (`userId`),
                       KEY `idx_deploy_key` (`deployKey`),
                       KEY `idx_create_time` (`createTime`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='应用表';


-- ai_code_mother.chat_history definition

CREATE TABLE `chat_history` (
                                `id` bigint(20) NOT NULL COMMENT '主键ID（雪花ID）',
                                `message` text COLLATE utf8mb4_unicode_ci COMMENT '消息内容',
                                `messageType` varchar(20) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '消息类型：user/ai',
                                `appId` bigint(20) NOT NULL COMMENT '应用ID',
                                `userId` bigint(20) NOT NULL COMMENT '创建用户ID',
                                `createTime` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
                                `updateTime` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
                                `isDelete` tinyint(4) DEFAULT '0' COMMENT '是否删除（0-未删除，1-已删除）',
                                PRIMARY KEY (`id`),
                                KEY `idx_app_id` (`appId`),
                                KEY `idx_user_id` (`userId`),
                                KEY `idx_create_time` (`createTime`),
                                KEY `idx_message_type` (`messageType`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='聊天记录表';


-- ai_code_mother.`user` definition

CREATE TABLE `user` (
                        `id` bigint(20) NOT NULL COMMENT '主键ID（雪花ID）',
                        `userAccount` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '账号',
                        `userPassword` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '密码（建议存储加密后的值）',
                        `userName` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '用户昵称',
                        `userAvatar` varchar(512) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '用户头像URL',
                        `userProfile` text COLLATE utf8mb4_unicode_ci COMMENT '用户简介',
                        `userRole` varchar(20) COLLATE utf8mb4_unicode_ci DEFAULT 'user' COMMENT '用户角色：user/admin',
                        `editTime` datetime DEFAULT NULL COMMENT '编辑时间',
                        `createTime` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
                        `updateTime` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
                        `isDelete` tinyint(4) DEFAULT '0' COMMENT '是否删除（0-未删除，1-已删除）',
                        PRIMARY KEY (`id`),
                        UNIQUE KEY `uk_user_account` (`userAccount`),
                        KEY `idx_user_role` (`userRole`),
                        KEY `idx_create_time` (`createTime`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户表';
